+        if (grid == null || rowZoomed) return;
+        rowZoomed = true;
+        // 3.0-uytv18: set now, before the first layout. In 3.0-uytv17 it was set after the tiles were made, so the
+        // cells shrank but the tiles kept their full width, overlapped, and the dock's glass band was lost.
+        int width = activity.getResources().getDisplayMetrics().widthPixels;
+        int extra = Math.round(width * (1f - ROW_ZOOM));
+        grid.setPaddingRelative(grid.getPaddingStart(), grid.getPaddingTop(), grid.getPaddingEnd() + extra, grid.getPaddingBottom());
+        // Tiles already made (a layout before this) are made again at the new size.
+        if (grid.isLaidOut() && grid instanceof androidx.recyclerview.widget.RecyclerView) {
+            androidx.recyclerview.widget.RecyclerView rv = (androidx.recyclerview.widget.RecyclerView) grid;
+            rv.setAdapter(rv.getAdapter());
+        }
     }
 
