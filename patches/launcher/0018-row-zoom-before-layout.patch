     private void zoomOutRow() {
         View grid = activity.findViewById(R.id.grid);
-        if (grid == null) return;
-        grid.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {
-            if (rowZoomed || r - l <= 0) return;
-            rowZoomed = true;
-            int extra = Math.round((r - l) * (1f - ROW_ZOOM));
