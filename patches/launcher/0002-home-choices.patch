--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/UytvHome.java
@@ -0,0 +1,290 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.content.res.Resources;
+import android.graphics.Color;
+import android.graphics.Outline;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.text.format.DateUtils;
+import android.util.Log;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewOutlineProvider;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import org.json.JSONObject;
+
+/**
+ * Upgrade Your TV: three home screen choices the phone app writes into config.json (carried keys the
+ * launcher 3.0 Config does not read itself):
+ * <ul>
+ *   <li>{@code uytv_signal}: dot-matrix type (res/font/uytv_dots.ttf, this repo's own font) for the clock,
+ *       the date, the greeting and the big app name, in capitals.</li>
+ *   <li>{@code uytv_sidebar}: the apps in a frosted panel down the left, each with its icon and name, instead of
+ *       the grid; "All apps" at its foot opens the App library.</li>
+ *   <li>{@code uytv_continue}: a frosted card at the bottom right, "Continue in {app}", for the app Home opened
+ *       last, with how long ago.</li>
+ * </ul>
+ * Every step is guarded: if anything here fails, Home stays as the look made it.
+ */
+final class UytvHome {
+    private static final String TAG = "TvHome.Uytv";
+    static final int MAX_SIDEBAR_APPS = 7;
+
+    final boolean signal;
+    final boolean sidebar;
+    final boolean continueCard;
+
+    private final Activity activity;
+    private final AppAdapter adapter;
+    private final AppAdapter.TileListener listener;
+    private final float density;
+    private Typeface dots;
+    private LinearLayout panel;
+    private LinearLayout card;
+
+    private UytvHome(Activity activity, AppAdapter adapter, AppAdapter.TileListener listener, JSONObject json) {
+        this.activity = activity;
+        this.adapter = adapter;
+        this.listener = listener;
+        this.density = activity.getResources().getDisplayMetrics().density;
+        this.signal = json != null && json.optBoolean("uytv_signal", false);
+        this.sidebar = json != null && json.optBoolean("uytv_sidebar", false);
+        this.continueCard = json != null && json.optBoolean("uytv_continue", false);
+    }
+
+    /** Null when none of the three is on. */
+    static UytvHome attach(Activity activity, AppAdapter adapter, AppAdapter.TileListener listener) {
+        try {
+            UytvHome home = new UytvHome(activity, adapter, listener, Config.lastOverlay);
+            if (!home.signal && !home.sidebar && !home.continueCard) return null;
+            home.build();
+            return home;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "home choices skipped: " + e);
+            return null;
+        }
+    }
+
+    private int dp(float v) {
+        return Math.round(v * density);
+    }
+
+    private void build() {
+        if (signal) {
+            try {
+                dots = activity.getResources().getFont(R.font.uytv_dots);
+            } catch (Resources.NotFoundException e) {
+                dots = null;
+            }
+            if (dots != null) {
+                for (int id : new int[] {R.id.clock, R.id.ampm, R.id.date, R.id.greeting, R.id.heroName, R.id.heroMeta}) {
+                    View v = activity.findViewById(id);
+                    if (v instanceof TextView) {
+                        TextView t = (TextView) v;
+                        t.setTypeface(dots);
+                        t.setAllCaps(true);
+                        t.setLetterSpacing(0.02f);
+                    }
+                }
+            }
+        }
+        ViewGroup root = activity.findViewById(R.id.root);
+        if (sidebar) {
+            View grid = activity.findViewById(R.id.grid);
+            if (grid != null && grid.getParent() instanceof View) ((View) grid.getParent()).setVisibility(View.GONE);
+            View hero = activity.findViewById(R.id.hero);
+            if (hero != null) hero.setVisibility(View.GONE);
+            panel = new LinearLayout(activity);
+            panel.setOrientation(LinearLayout.VERTICAL);
+            panel.setPadding(dp(10), dp(10), dp(10), dp(10));
+            panel.setBackground(glass(28, 0x2EFFFFFF));
+            FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(dp(330), ViewGroup.LayoutParams.WRAP_CONTENT,
+                    Gravity.START | Gravity.CENTER_VERTICAL);
+            lp.setMarginStart(dp(56));
+            lp.topMargin = dp(120);
+            lp.bottomMargin = dp(40);
+            root.addView(panel, lp);
+        }
+        if (continueCard) {
+            card = new LinearLayout(activity);
+            card.setOrientation(LinearLayout.HORIZONTAL);
+            card.setGravity(Gravity.CENTER_VERTICAL);
+            card.setPadding(dp(12), dp(10), dp(22), dp(10));
+            card.setBackground(focusable(36, 0x33FFFFFF, 0xF2FFFFFF));
+            card.setFocusable(true);
+            card.setClickable(true);
+            card.setVisibility(View.GONE);
+            FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.END | Gravity.BOTTOM);
+            lp.setMarginEnd(dp(56));
+            lp.bottomMargin = dp(40);
+            root.addView(card, lp);
+        }
+    }
+
+    /** After the tiles were loaded again, and on every return to Home. */
+    void refresh() {
+        try {
+            if (panel != null) fillPanel();
+            if (card != null) fillCard();
+        } catch (RuntimeException e) {
+            Log.w(TAG, "refresh skipped: " + e);
+        }
+    }
+
+    private void fillPanel() {
+        View focused = activity.getCurrentFocus();
+        boolean hadFocus = focused != null && isInside(focused, panel);
+        panel.removeAllViews();
+        int shown = 0;
+        View first = null;
+        for (int i = 0; i < adapter.getItemCount() && shown < MAX_SIDEBAR_APPS; i++) {
+            if (adapter.kindAt(i) != AppAdapter.Entry.APP) continue;
+            final int position = i;
+            View row = row(adapter.iconAt(i), adapter.labelAt(i), 26, v -> adapter.launchAt(position));
+            panel.addView(row);
+            if (first == null) first = row;
+            shown++;
+        }
+        View all = row(null, activity.getString(R.string.uytv_all_apps), 17, v -> listener.onLibraryRequested());
+        panel.addView(all);
+        if (card != null) {
+            for (int i = 0; i < panel.getChildCount(); i++) panel.getChildAt(i).setNextFocusRightId(cardId());
+        }
+        if (first != null && (hadFocus || focused == null || !focused.isShown())) {
+            final View target = first;
+            panel.post(target::requestFocus);
+        }
+    }
+
+    private int cardId() {
+        if (card.getId() == View.NO_ID) card.setId(View.generateViewId());
+        return card.getId();
+    }
+
+    private void fillCard() {
+        String best = null;
+        long when = 0;
+        int bestPos = -1;
+        for (int i = 0; i < adapter.getItemCount(); i++) {
+            if (adapter.kindAt(i) != AppAdapter.Entry.APP) continue;
+            long t = LastOpened.get(activity, adapter.packageAt(i));
+            if (t > when) {
+                when = t;
+                best = adapter.labelAt(i);
+                bestPos = i;
+            }
+        }
+        card.removeAllViews();
+        if (bestPos < 0) {
+            card.setVisibility(View.GONE);
+            return;
+        }
+        final int position = bestPos;
+        ImageView icon = icon(adapter.iconAt(position), 44);
+        card.addView(icon);
+        LinearLayout texts = new LinearLayout(activity);
+        texts.setOrientation(LinearLayout.VERTICAL);
+        texts.setPadding(dp(14), 0, 0, 0);
+        TextView title = text(activity.getString(R.string.uytv_continue_in, best), 18, Color.WHITE);
+        CharSequence ago = DateUtils.getRelativeTimeSpanString(when, System.currentTimeMillis(), DateUtils.MINUTE_IN_MILLIS);
+        TextView sub = text(activity.getString(R.string.uytv_last_opened, ago), 13, 0xB3FFFFFF);
+        texts.addView(title);
+        texts.addView(sub);
+        card.addView(texts);
+        card.setOnClickListener(v -> adapter.launchAt(position));
+        card.setOnFocusChangeListener((v, has) -> {
+            int ink = has ? 0xFF111111 : Color.WHITE;
+            title.setTextColor(ink);
+            sub.setTextColor(has ? 0xB3111111 : 0xB3FFFFFF);
+        });
+        card.setVisibility(View.VISIBLE);
+    }
+
+    private View row(Drawable art, String label, int iconDp, View.OnClickListener click) {
+        LinearLayout row = new LinearLayout(activity);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setPadding(dp(12), dp(9), dp(12), dp(9));
+        row.setFocusable(true);
+        row.setClickable(true);
+        row.setBackground(focusable(18, 0x00FFFFFF, 0xF2FFFFFF));
+        if (art != null) {
+            row.addView(icon(art, 40));
+        }
+        TextView name = text(label, signal ? 18 : 20, Color.WHITE);
+        name.setPadding(dp(art != null ? 16 : 6), 0, 0, 0);
+        if (art == null) name.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        row.addView(name, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        row.setOnClickListener(click);
+        row.setOnFocusChangeListener((v, has) -> name.setTextColor(has ? 0xFF111111 : Color.WHITE));
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.topMargin = dp(2);
+        row.setLayoutParams(lp);
+        return row;
+    }
+
+    private ImageView icon(Drawable art, int sizeDp) {
+        ImageView v = new ImageView(activity);
+        v.setImageDrawable(art);
+        v.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        final float radius = dp(10);
+        v.setOutlineProvider(new ViewOutlineProvider() {
+            @Override
+            public void getOutline(View view, Outline outline) {
+                outline.setRoundRect(0, 0, view.getWidth(), view.getHeight(), radius);
+            }
+        });
+        v.setClipToOutline(true);
+        v.setLayoutParams(new LinearLayout.LayoutParams(dp(sizeDp), dp(sizeDp)));
+        return v;
+    }
+
+    private TextView text(String s, int sp, int color) {
+        TextView t = new TextView(activity);
+        t.setText(s);
+        t.setTextColor(color);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setSingleLine(true);
+        t.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        if (signal && dots != null) {
+            t.setTypeface(dots);
+            t.setAllCaps(true);
+        }
+        return t;
+    }
+
+    private GradientDrawable glass(int radiusDp, int fill) {
+        GradientDrawable g = new GradientDrawable();
+        g.setCornerRadius(dp(radiusDp));
+        g.setColor(fill);
+        g.setStroke(Math.max(1, dp(1)), 0x40FFFFFF);
+        return g;
+    }
+
+    private Drawable focusable(int radiusDp, int rest, int focused) {
+        android.graphics.drawable.StateListDrawable s = new android.graphics.drawable.StateListDrawable();
+        GradientDrawable on = new GradientDrawable();
+        on.setCornerRadius(dp(radiusDp));
+        on.setColor(focused);
+        s.addState(new int[] {android.R.attr.state_focused}, on);
+        s.addState(new int[] {android.R.attr.state_pressed}, on);
+        s.addState(new int[] {}, rest == 0 ? new GradientDrawable() : glass(radiusDp, rest));
+        return s;
+    }
+
+    private static boolean isInside(View v, View parent) {
+        for (View p = v; p != null; p = p.getParent() instanceof View ? (View) p.getParent() : null) {
+            if (p == parent) return true;
+        }
+        return false;
+    }
+}
