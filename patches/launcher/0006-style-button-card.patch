+    /**
+     * A Style button at the start of the top bar (the round pills by the network pill): the theme and layout on
+     * the TV itself (UytvSettingsActivity), one press from Home.
+     */
+    private void addStyleButton() {
+        ViewGroup bar = activity.findViewById(R.id.topButtons);
+        if (bar == null) return;
+        TextView button = (TextView) activity.getLayoutInflater().inflate(R.layout.top_app_button, bar, false);
+        button.setId(View.generateViewId());
+        Drawable icon = activity.getDrawable(R.drawable.uytv_ic_style);
+        if (icon != null) {
+            int size = dp(22);
+            icon.setBounds(0, 0, size, size);
+            button.setCompoundDrawablesRelative(icon, null, null, null);
+        }
+        button.setContentDescription(activity.getString(R.string.uytv_style));
+        button.setOnClickListener(v -> {
+            try {
+                activity.startActivity(new android.content.Intent(activity, UytvSettingsActivity.class));
+            } catch (RuntimeException e) {
+                Log.w(TAG, "no Style page: " + e);
+            }
+        });
+        bar.addView(button, 0);
+    }
