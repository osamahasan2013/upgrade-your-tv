+    /** Upgrade Your TV (3.0-uytv17): takes an app out of the dock; the dock is saved one app shorter. */
+    void uytvRemoveFromDock(String key) {
+        try {
+            if (!dockRow || key == null || reordering) return;
+            if (!beginReorder()) return;
+            int at = adapter.positionOf(key);
+            if (at < 0 || !dockInSession.contains(key)) {
+                endReorder();
+                reloadTiles();
+                return;
+            }
+            dockInSession.remove(key);
+            // Just after the apps that stay in the dock, so nothing else moves.
+            int to = Math.min(dockInSession.size(), adapter.movableCount() - 1);
+            if (at != to) adapter.move(at, to);
+            boolean leaves = fillDockLeavesSlots;
+            fillDockLeavesSlots = true;
+            try {
+                endReorder();
+            } finally {
+                fillDockLeavesSlots = leaves;
+            }
+            reloadTiles();
+            focusTile(0);
+            Toast.makeText(this, R.string.uytv_removed_from_dock, Toast.LENGTH_SHORT).show();
+        } catch (RuntimeException e) {
+            android.util.Log.w("TvHome.Uytv", "not taken out of the dock: " + e);
+        }
+    }
