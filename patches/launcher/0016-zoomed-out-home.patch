+    /** The zoomed-out row: the dock and grid take ROW_ZOOM of the width, cells and tiles shrinking together. */
+    static final float ROW_ZOOM = 0.78f;
+    private boolean rowZoomed;
+
+    private void zoomOutRow() {
+        View grid = activity.findViewById(R.id.grid);
+        if (grid == null) return;
+        grid.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {
+            if (rowZoomed || r - l <= 0) return;
+            rowZoomed = true;
+            int extra = Math.round((r - l) * (1f - ROW_ZOOM));
+            v.post(() -> v.setPaddingRelative(v.getPaddingStart(), v.getPaddingTop(), v.getPaddingEnd() + extra, v.getPaddingBottom()));
+        });
+    }
+
+    /** The top bar's buttons a little higher; the clock stays where it is. */
+    private void raiseTopButtons() {
+        View bar = activity.findViewById(R.id.topButtons);
+        if (bar == null || !(bar.getLayoutParams() instanceof ViewGroup.MarginLayoutParams)) return;
+        ViewGroup.MarginLayoutParams lp = (ViewGroup.MarginLayoutParams) bar.getLayoutParams();
+        lp.bottomMargin += dp(34);
+        bar.setLayoutParams(lp);
+    }
+
+    private void placeCardUnderTopBar() {
+        View bar = activity.findViewById(R.id.topButtons);
+        if (bar == null) return;
+        bar.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {
+            if (card == null || !(card.getParent() instanceof View) || !(card.getLayoutParams() instanceof FrameLayout.LayoutParams)) return;
+            int[] at = new int[2];
+            v.getLocationInWindow(at);
+            int[] rootAt = new int[2];
+            ((View) card.getParent()).getLocationInWindow(rootAt);
+            int want = at[1] - rootAt[1] + v.getHeight() + dp(22);
+            FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams) card.getLayoutParams();
+            if (want > 0 && lp.topMargin != want) {
+                lp.topMargin = want;
+                card.post(() -> card.setLayoutParams(lp));
+            }
+        });
+    }
