@@ -0,0 +1,88 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONObject;
+
+/**
+ * Upgrade Your TV: the home screen choices in effect. The phone app writes them into config.json (uytv_* keys);
+ * the TV's own "Style" page (UytvSettingsActivity) can change any of them on the TV. A choice made on the TV
+ * holds until the phone sends a different config.json: the TV's choices remember which one they were made over
+ * (its text's hash) and step aside when it changes, so the newest choice wins wherever it was made.
+ */
+final class UytvChoices {
+    static final String PREFS = "uytv_choices";
+    private static final String BASE = "base";
+
+    static final String[] THEMES = {"none", "glass", "signal", "signal_dark", "gaming", "islamic", "halloween", "horror", "anime"};
+
+    String theme = "none";
+    boolean themeBg;
+    boolean signal;
+    boolean sidebar;
+    boolean rightSide;
+    String names = "large";
+    boolean dockOnly;
+    boolean continueCard;
+
+    boolean any() {
+        return !"none".equals(theme) || signal || sidebar || rightSide || !"large".equals(names) || dockOnly || continueCard;
+    }
+
+    static UytvChoices read(Context ctx) {
+        UytvChoices c = new UytvChoices();
+        JSONObject json = Config.lastOverlay;
+        if (json != null) {
+            c.theme = known(json.optString("uytv_theme", "none"));
+            c.themeBg = json.optBoolean("uytv_theme_bg", false);
+            c.signal = json.optBoolean("uytv_signal", false);
+            c.sidebar = json.optBoolean("uytv_sidebar", false);
+            c.rightSide = "right".equals(json.optString("uytv_side", "left"));
+            c.names = names(json.optString("uytv_names", "large"));
+            c.dockOnly = json.optBoolean("uytv_dock_only", false);
+            c.continueCard = json.optBoolean("uytv_continue", false);
+        }
+        SharedPreferences p = prefs(ctx);
+        if (p.getInt(BASE, 0) != base() || p.getAll().size() <= 1) return c;
+        c.theme = known(p.getString("theme", c.theme));
+        c.themeBg = p.getBoolean("theme_bg", c.themeBg);
+        c.signal = p.getBoolean("signal", c.signal);
+        c.sidebar = p.getBoolean("sidebar", c.sidebar);
+        c.rightSide = p.getBoolean("right", c.rightSide);
+        c.names = names(p.getString("names", c.names));
+        c.dockOnly = p.getBoolean("dock_only", c.dockOnly);
+        c.continueCard = p.getBoolean("continue", c.continueCard);
+        return c;
+    }
+
+    /** Saves all of them as the TV's choices, over the config.json in effect now. */
+    void save(Context ctx) {
+        SharedPreferences.Editor e = prefs(ctx).edit().clear().putInt(BASE, base())
+                .putString("theme", theme).putBoolean("theme_bg", themeBg).putBoolean("signal", signal)
+                .putBoolean("sidebar", sidebar).putBoolean("right", rightSide).putString("names", names)
+                .putBoolean("dock_only", dockOnly).putBoolean("continue", continueCard);
+        e.apply();
+        // Home rebuilds on its next resume (MainActivity compares the launcher settings revision).
+        SharedPreferences s = ctx.getSharedPreferences(Config.SETTINGS_NAME, Context.MODE_PRIVATE);
+        s.edit().putLong(Config.SETTINGS_REVISION_KEY, s.getLong(Config.SETTINGS_REVISION_KEY, 0) + 1).apply();
+    }
+
+    private static SharedPreferences prefs(Context ctx) {
+        return ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static int base() {
+        JSONObject json = Config.lastOverlay;
+        return json == null ? 1 : json.toString().hashCode() | 1;
+    }
+
+    private static String known(String t) {
+        for (String k : THEMES) if (k.equals(t)) return t;
+        return "none";
+    }
+
+    private static String names(String n) {
+        return "small".equals(n) || "hidden".equals(n) ? n : "large";
+    }
+}
