+ * settings > Style). Each row cycles its choices with OK; Home is rebuilt with them on the way back. The phone app's
+ * next look replaces them (UytvChoices).
+ */
+public final class UytvSettingsActivity extends Activity {
+    @Override
+    protected void attachBaseContext(android.content.Context base) {
+        super.attachBaseContext(LauncherLocale.wrap(base));
+    }
+
+    private static final String[] THEME_NAMES = {"None", "Glass Pro", "Signal", "Signal Dark", "Gaming", "Islamic", "Halloween", "Horror", "Anime"};
+    private UytvChoices choices;
+    private ImageView preview;
+    private float density;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        density = getResources().getDisplayMetrics().density;
+        Config.load(this);   // the overlay the choices start from
+        choices = UytvChoices.read(this);
+
+        LinearLayout page = new LinearLayout(this);
+        page.setOrientation(LinearLayout.HORIZONTAL);
+        page.setBackgroundColor(0xFF101419);
+        page.setPadding(dp(72), dp(38), dp(72), dp(38));
+
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout list = new LinearLayout(this);
+        list.setOrientation(LinearLayout.VERTICAL);
+        scroll.addView(list);
+        page.addView(scroll, new LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.MATCH_PARENT, 1f));
+
+        TextView title = new TextView(this);
+        title.setText(R.string.uytv_style);
+        title.setTextColor(Color.WHITE);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 34);
+        list.addView(title);
+        TextView sub = new TextView(this);
+        sub.setText(R.string.uytv_style_sub);
+        sub.setTextColor(0xB3FFFFFF);
+        sub.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        sub.setPadding(0, dp(6), 0, dp(18));
+        list.addView(sub);
+
+        row(list, R.string.uytv_row_theme, () -> THEME_NAMES[index(UytvChoices.THEMES, choices.theme)], () -> {
+            int i = (index(UytvChoices.THEMES, choices.theme) + 1) % UytvChoices.THEMES.length;
+            choices.theme = UytvChoices.THEMES[i];
+            if (!"none".equals(choices.theme)) choices.themeBg = true;
+        }).requestFocus();
+        row(list, R.string.uytv_row_theme_bg, () -> onOff(choices.themeBg), () -> choices.themeBg = !choices.themeBg);
+        row(list, R.string.uytv_row_layout, () -> getString(choices.sidebar ? R.string.uytv_sidebar : R.string.uytv_row), () -> choices.sidebar = !choices.sidebar);
+        row(list, R.string.uytv_row_side, () -> getString(choices.rightSide ? R.string.uytv_right : R.string.uytv_left), () -> choices.rightSide = !choices.rightSide);
+        row(list, R.string.uytv_row_names, () -> getString("hidden".equals(choices.names) ? R.string.uytv_hidden
+                : "small".equals(choices.names) ? R.string.uytv_small : R.string.uytv_large), () -> choices.names =
+                "large".equals(choices.names) ? "small" : "small".equals(choices.names) ? "hidden" : "large");
+        row(list, R.string.uytv_row_dock_only, () -> onOff(choices.dockOnly), () -> choices.dockOnly = !choices.dockOnly);
+        row(list, R.string.uytv_row_continue, () -> onOff(choices.continueCard), () -> choices.continueCard = !choices.continueCard);
+        row(list, R.string.uytv_row_dots, () -> onOff(choices.signal), () -> choices.signal = !choices.signal);
+        TextView done = plainRow(getString(R.string.uytv_done));
+        done.setOnClickListener(v -> finish());
+        list.addView(done);
+
+        FrameLayout side = new FrameLayout(this);
+        preview = new ImageView(this);
+        preview.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        preview.setClipToOutline(true);
+        GradientDrawable frame = new GradientDrawable();
+        frame.setCornerRadius(dp(18));
+        frame.setColor(0xFF1C2028);
+        preview.setBackground(frame);
+        side.addView(preview, new FrameLayout.LayoutParams(dp(480), dp(270), Gravity.CENTER));
+        LinearLayout.LayoutParams sp = new LinearLayout.LayoutParams(dp(520), LinearLayout.LayoutParams.MATCH_PARENT);
+        sp.setMarginStart(dp(40));
+        page.addView(side, sp);
+        showPreview();
+        setContentView(page);
+    }
+
+    private interface Text { String get(); }
+
+    private TextView row(LinearLayout list, int label, Text value, Runnable next) {
+        TextView row = plainRow(getString(label) + ":  " + value.get());
+        row.setOnClickListener(v -> {
+            next.run();
+            choices.save(this);
+            row.setText(getString(label) + ":  " + value.get());
+            showPreview();
+        });
+        list.addView(row);
+        return row;
+    }
+
+    private TextView plainRow(String text) {
+        TextView row = new TextView(this);
+        row.setText(text);
+        row.setTextColor(Color.WHITE);
+        row.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setPadding(dp(18), 0, dp(18), 0);
+        row.setFocusable(true);
+        row.setClickable(true);
+        StateListDrawable bg = new StateListDrawable();
+        GradientDrawable on = new GradientDrawable();
+        on.setCornerRadius(dp(12));
+        on.setColor(0x40FFFFFF);
+        GradientDrawable off = new GradientDrawable();
+        off.setCornerRadius(dp(12));
+        off.setColor(0x12FFFFFF);
+        bg.addState(new int[] {android.R.attr.state_focused}, on);
+        bg.addState(new int[] {}, off);
+        row.setBackground(bg);
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(52));
+        lp.topMargin = dp(8);
+        row.setLayoutParams(lp);
+        return row;
+    }
+
+    private void showPreview() {
+        UytvTheme t = UytvTheme.of(choices.theme);
+        if (t != null) preview.setImageResource(t.background);
+        else preview.setImageDrawable(null);
+    }
+
+    private String onOff(boolean on) {
+        return getString(on ? R.string.uytv_on : R.string.uytv_off);
+    }
+
+    private static int index(String[] all, String v) {
+        for (int i = 0; i < all.length; i++) if (all[i].equals(v)) return i;
+        return 0;
+    }
+
+    private int dp(float v) {
+        return Math.round(v * density);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/UytvTheme.java b/launcher/app/src/main/java/com/gathin/tvhome/UytvTheme.java
new file mode 100644
index 00000000..b114f84f
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/UytvTheme.java
@@ -0,0 +1,81 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Typeface;
+
+/**
+ * Upgrade Your TV's themes (uytv_theme): type, colours, the picture behind Home and a greeting, applied by
+ * UytvHome. Fonts are open-licence Google Fonts fetched and cut down to the letters used when the launcher is
+ * built (.github/workflows/launcher.yml; licences in assets/fonts-licences.txt), named uytv_f_*; one that is
+ * missing falls back to the launcher's own type. The dot type is this repo's own (uytv_dots).
+ */
+final class UytvTheme {
+    final String id;
+    final String titleFont;     // a uytv_f_* name, "dots", or null for the launcher's own
+    final String bodyFont;
+    final boolean caps;
+    final boolean dots;          // the dot connector from the focused app up to its name
+    final int ink;               // text over the picture
+    final int subInk;
+    final int panelFill;         // sidebar, Continue card
+    final int panelStroke;
+    final int focusFill;
+    final int focusInk;
+    final int accent;            // the connector dot, the focus glow
+    final int background;        // R.drawable.uytv_bg_*
+    final String greeting;       // null: the launcher's own greeting
+    final boolean hijri;         // the Hijri date under the date
+    final float panelRadius;
+
+    private UytvTheme(String id, String titleFont, String bodyFont, boolean caps, boolean dots, int ink, int subInk,
+                      int panelFill, int panelStroke, int focusFill, int focusInk, int accent, int background,
+                      String greeting, boolean hijri, float panelRadius) {
+        this.id = id; this.titleFont = titleFont; this.bodyFont = bodyFont; this.caps = caps; this.dots = dots;
+        this.ink = ink; this.subInk = subInk; this.panelFill = panelFill; this.panelStroke = panelStroke;
+        this.focusFill = focusFill; this.focusInk = focusInk; this.accent = accent; this.background = background;
+        this.greeting = greeting; this.hijri = hijri; this.panelRadius = panelRadius;
+    }
+
+    /** Null for "none": the look as the launcher draws it. */
+    static UytvTheme of(String id) {
+        switch (id) {
+            case "glass":
+                return new UytvTheme(id, "uytv_f_inter", "uytv_f_inter", false, false, 0xFFFFFFFF, 0xD9FFFFFF,
+                        0x29FFFFFF, 0x52FFFFFF, 0xEBFFFFFF, 0xFF111111, 0xFFFFFFFF, R.drawable.uytv_bg_glass, null, false, 28);
+            case "signal":
+                return new UytvTheme(id, "dots", "uytv_f_spacemono", true, true, 0xFF111111, 0xFF4A4D52,
+                        0xC0FFFFFF, 0xFFC8CCD2, 0xFF111111, 0xFFF1F2F4, 0xFFD71921, R.drawable.uytv_bg_signal, null, false, 26);
+            case "signal_dark":
+                return new UytvTheme(id, "dots", "uytv_f_spacemono", true, true, 0xFFF1F2F4, 0xFFB8BCC3,
+                        0xEB121315, 0xFF2C2F34, 0xFFF1F2F4, 0xFF0A0A0B, 0xFFD71921, R.drawable.uytv_bg_signal_dark, null, false, 22);
+            case "gaming":
+                return new UytvTheme(id, "uytv_f_orbitron", "uytv_f_rajdhani", true, false, 0xFFFFFFFF, 0xFFC9B8FF,
+                        0xCC0B0824, 0xFF2EF2FF, 0xFF2EF2FF, 0xFF07061A, 0xFF2EF2FF, R.drawable.uytv_bg_gaming, "PLAYER 1 · READY", false, 6);
+            case "islamic":
+                return new UytvTheme(id, "uytv_f_reemkufi", "uytv_f_reemkufi", false, false, 0xFFF6ECD2, 0xFFE8C674,
+                        0xB3031712, 0x8CC9A24A, 0xFFE8C674, 0xFF06281F, 0xFFE8C674, R.drawable.uytv_bg_islamic, "السلام عليكم", true, 20);
+            case "halloween":
+                return new UytvTheme(id, "uytv_f_creepster", "uytv_f_nunito", false, false, 0xFFFFF4E6, 0xFFD9B8FF,
+                        0xB31A0B2E, 0x99FF8A1F, 0xFFFF8A1F, 0xFF1A0B2E, 0xFFFF8A1F, R.drawable.uytv_bg_halloween, "Happy Halloween", false, 22);
+            case "horror":
+                return new UytvTheme(id, "uytv_f_nosifer", "uytv_f_specialelite", true, false, 0xFFD8D2C8, 0xFF8D857A,
+                        0xD9100C0B, 0xFF5A1416, 0xFF1A0607, 0xFFE0262B, 0xFFC4161C, R.drawable.uytv_bg_horror, "don't look behind you", false, 6);
+            case "anime":
+                return new UytvTheme(id, "uytv_f_fredoka", "uytv_f_fredoka", false, false, 0xFFFFFFFF, 0xFFFFF1F5,
+                        0x40FFFFFF, 0x80FFFFFF, 0xF2FFFFFF, 0xFFE0577E, 0xFFFF7EA6, R.drawable.uytv_bg_anime, "Konnichiwa!", false, 30);
+            default:
+                return null;
+        }
+    }
+
+    /** A theme font by name, or null when this build has none by that name. */
+    static Typeface font(Context ctx, String name) {
+        if (name == null) return null;
+        try {
+            int id = "dots".equals(name) ? R.font.uytv_dots : ctx.getResources().getIdentifier(name, "font", ctx.getPackageName());
+            return id == 0 ? null : ctx.getResources().getFont(id);
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+}
