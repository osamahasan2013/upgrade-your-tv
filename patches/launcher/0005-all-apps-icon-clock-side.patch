+    /** With the sidebar on the left, the clock and the date move to the right and the top buttons to the left. */
+    private void moveClockRight() {
+        View block = activity.findViewById(R.id.leftBlock);
+        View buttons = activity.findViewById(R.id.topButtons);
+        if (block == null || buttons == null || !(block.getLayoutParams() instanceof android.widget.RelativeLayout.LayoutParams)
+                || !(buttons.getLayoutParams() instanceof android.widget.RelativeLayout.LayoutParams)) return;
+        android.widget.RelativeLayout.LayoutParams bl = (android.widget.RelativeLayout.LayoutParams) block.getLayoutParams();
+        bl.removeRule(android.widget.RelativeLayout.ALIGN_PARENT_START);
+        bl.removeRule(android.widget.RelativeLayout.START_OF);
+        bl.addRule(android.widget.RelativeLayout.ALIGN_PARENT_END);
+        bl.addRule(android.widget.RelativeLayout.END_OF, R.id.topButtons);
+        bl.setMarginEnd(0);
+        bl.setMarginStart(dp(16));
+        block.setLayoutParams(bl);
+        android.widget.RelativeLayout.LayoutParams tl = (android.widget.RelativeLayout.LayoutParams) buttons.getLayoutParams();
+        tl.removeRule(android.widget.RelativeLayout.ALIGN_PARENT_END);
+        tl.addRule(android.widget.RelativeLayout.ALIGN_PARENT_START);
+        buttons.setLayoutParams(tl);
+        if (block instanceof LinearLayout) ((LinearLayout) block).setGravity(Gravity.RIGHT);
+        TextView greeting = activity.findViewById(R.id.greeting);
+        if (greeting != null) greeting.setGravity(Gravity.RIGHT);
+        View clock = activity.findViewById(R.id.clock);
+        if (clock != null && clock.getParent() instanceof LinearLayout) {
+            LinearLayout row = (LinearLayout) clock.getParent();
+            row.setGravity(Gravity.RIGHT | Gravity.BOTTOM);
+        }
+    }
+
     private int ink() { return theme != null ? theme.ink : Color.WHITE; }
