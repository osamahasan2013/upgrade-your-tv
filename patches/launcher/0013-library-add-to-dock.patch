+    /**
+     * Upgrade Your TV (3.0-uytv14): an app from the App library straight into the dock. The dock holds as many
+     * apps as the look's "apps in a row" (COLUMNS): with a free place the app takes the next one; with the dock
+     * full, the launcher's own "Add to dock" starts, where the place to replace is picked.
+     */
+    void uytvAddToDock(String pkg) {
+        try {
+            if (!dockRow || pkg == null || reordering) return;
+            if (!beginReorder()) return;   // every app is a tile now; dockInSession holds the dock's
+            int at = -1;
+            for (int i = 0; i < adapter.movableCount(); i++) {
+                if (pkg.equals(adapter.packageAt(i))) { at = i; break; }
+            }
+            String key = at < 0 ? null : adapter.keyAt(at);
+            if (key == null || dockInSession.contains(key)) {
+                endReorder();
+                reloadTiles();
+                return;
+            }
+            if (dockInSession.size() >= COLUMNS) {
+                endReorder();
+                startDockEditFor(key, false);
+                return;
+            }
+            int slot = Math.min(dockInSession.size(), adapter.movableCount() - 1);
+            if (at != slot) adapter.move(at, slot);
+            dockInSession.add(key);
+            endReorder();
+            reloadTiles();
+            focusTile(Math.max(0, adapter.positionOf(key)));
+        } catch (RuntimeException e) {
+            android.util.Log.w("TvHome.Uytv", "not added to the dock: " + e);
+        }
+    }
+
