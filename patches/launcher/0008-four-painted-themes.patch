diff --git a/launcher/app/src/main/java/com/gathin/tvhome/UytvFrame.java b/launcher/app/src/main/java/com/gathin/tvhome/UytvFrame.java
new file mode 100644
index 00000000..6049e0fa
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/UytvFrame.java
@@ -0,0 +1,140 @@
+package com.gathin.tvhome;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+
+/**
+ * Upgrade Your TV (3.0-uytv8): a theme's frame over an app's tile, drawn in code at the tile's size (no pictures):
+ * "shell" a pearl rim with a scalloped crest and ribs (Deep sea), "glass" a clear pane with a light top (Space),
+ * "scroll" a parchment rim with curled corners (Cloud castle), "neon" a glowing tube in one of six colours
+ * (Neon city). Drawn as the card's foreground, over the app's banner; it takes no focus and no touch.
+ */
+final class UytvFrame extends Drawable {
+    private static final int[] NEON = {0xFFFF2E88, 0xFF22D3EE, 0xFFFF3B3B, 0xFF39FF88, 0xFFFFC23D, 0xFFB45CFF};
+    private final String style;
+    private final int index;
+    private final float dp;
+    private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF r = new RectF();
+
+    UytvFrame(String style, int index, float density) {
+        this.style = style;
+        this.index = index;
+        this.dp = density;
+        p.setStyle(Paint.Style.STROKE);
+    }
+
+    @Override
+    public void draw(Canvas c) {
+        float w = getBounds().width(), h = getBounds().height();
+        if (w <= 0 || h <= 0) return;
+        c.save();
+        c.translate(getBounds().left, getBounds().top);
+        switch (style) {
+            case "shell": shell(c, w, h); break;
+            case "glass": glass(c, w, h); break;
+            case "scroll": scroll(c, w, h); break;
+            case "neon": neon(c, w, h); break;
+            default: break;
+        }
+        c.restore();
+    }
+
+    private void shell(Canvas c, float w, float h) {
+        float rad = 16 * dp, s = 3 * dp;
+        p.setShader(null);
+        // ribs fanning up from the hinge
+        p.setStrokeWidth(dp);
+        p.setColor(0x33FFFFFF);
+        int ribs = 7;
+        for (int i = 0; i < ribs; i++) {
+            float x = w * (i + 0.5f) / ribs;
+            c.drawLine(w / 2, h - 2 * dp, x, 6 * dp, p);
+        }
+        // the scalloped crest along the top
+        p.setStrokeWidth(2 * dp);
+        p.setColor(0xFFF3D9A4);
+        float bump = w / ribs;
+        for (int i = 0; i < ribs; i++) {
+            r.set(i * bump + dp, s / 2, (i + 1) * bump - dp, bump * 0.7f + s / 2);
+            c.drawArc(r, 180, 180, false, p);
+        }
+        // the pearl rim
+        p.setStrokeWidth(s);
+        p.setShader(new LinearGradient(0, 0, w, h, 0xFFFFF4DC, 0xFFC9A46A, Shader.TileMode.CLAMP));
+        r.set(s / 2, s / 2, w - s / 2, h - s / 2);
+        c.drawRoundRect(r, rad, rad, p);
+        p.setShader(null);
+        p.setStrokeWidth(dp);
+        p.setColor(0x66FFFFFF);
+        r.inset(s, s);
+        c.drawRoundRect(r, rad - s, rad - s, p);
+    }
+
+    private void glass(Canvas c, float w, float h) {
+        float rad = 14 * dp;
+        p.setStyle(Paint.Style.FILL);
+        p.setShader(new LinearGradient(0, 0, 0, h * 0.55f, 0x40FFFFFF, 0x00FFFFFF, Shader.TileMode.CLAMP));
+        r.set(0, 0, w, h);
+        c.drawRoundRect(r, rad, rad, p);
+        p.setShader(null);
+        p.setStyle(Paint.Style.STROKE);
+        p.setStrokeWidth(1.5f * dp);
+        p.setColor(0x99FFFFFF);
+        r.set(dp, dp, w - dp, h - dp);
+        c.drawRoundRect(r, rad, rad, p);
+    }
+
+    private void scroll(Canvas c, float w, float h) {
+        float s = 3 * dp, rad = 6 * dp, curl = 7 * dp;
+        p.setShader(null);
+        p.setStrokeWidth(s);
+        p.setColor(0xFFC9A46A);
+        r.set(s / 2, s / 2, w - s / 2, h - s / 2);
+        c.drawRoundRect(r, rad, rad, p);
+        p.setStrokeWidth(dp);
+        p.setColor(0x80FFF1CC);
+        r.inset(2.5f * dp, 2.5f * dp);
+        c.drawRoundRect(r, rad, rad, p);
+        float[][] at = {{curl, curl}, {w - curl, curl}, {curl, h - curl}, {w - curl, h - curl}};
+        for (float[] a : at) {
+            p.setStyle(Paint.Style.FILL);
+            p.setColor(0xFFE8D3A0);
+            c.drawCircle(a[0], a[1], curl, p);
+            p.setStyle(Paint.Style.STROKE);
+            p.setStrokeWidth(1.5f * dp);
+            p.setColor(0xFF7A5530);
+            c.drawCircle(a[0], a[1], curl, p);
+            c.drawCircle(a[0], a[1], curl * 0.45f, p);
+        }
+    }
+
+    private void neon(Canvas c, float w, float h) {
+        int col = NEON[index % NEON.length];
+        float rad = 8 * dp;
+        p.setShader(null);
+        p.setColor((col & 0x00FFFFFF) | 0x40000000);
+        p.setStrokeWidth(7 * dp);
+        r.set(3.5f * dp, 3.5f * dp, w - 3.5f * dp, h - 3.5f * dp);
+        c.drawRoundRect(r, rad, rad, p);
+        p.setColor((col & 0x00FFFFFF) | 0x80000000);
+        p.setStrokeWidth(4 * dp);
+        c.drawRoundRect(r, rad, rad, p);
+        p.setColor(col);
+        p.setStrokeWidth(2 * dp);
+        c.drawRoundRect(r, rad, rad, p);
+        p.setColor(0xCCFFFFFF);
+        p.setStrokeWidth(0.8f * dp);
+        c.drawRoundRect(r, rad, rad, p);
+    }
+
+    @Override public void setAlpha(int alpha) { p.setAlpha(alpha); }
+    @Override public void setColorFilter(ColorFilter f) { p.setColorFilter(f); }
+    @Override public int getOpacity() { return PixelFormat.TRANSLUCENT; }
+}
