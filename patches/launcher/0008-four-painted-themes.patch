         View glassView = activity.findViewById(R.id.glass);
         if (glassView instanceof GlassView) ((GlassView) glassView).setAccent(theme.accent);
         if (theme.hijri) addHijri();
+        if (theme.arabicDate) addArabicDate();
+        if (theme.frame != null) dressTiles();
+    }
+
+    /** 3.0-uytv8: each app's tile in the theme's frame (UytvFrame), as the row makes or reuses it. */
+    private void dressTiles() {
+        View g = activity.findViewById(R.id.grid);
+        if (!(g instanceof androidx.recyclerview.widget.RecyclerView)) return;
+        androidx.recyclerview.widget.RecyclerView grid = (androidx.recyclerview.widget.RecyclerView) g;
+        final int[] made = {0};
+        grid.addOnChildAttachStateChangeListener(new androidx.recyclerview.widget.RecyclerView.OnChildAttachStateChangeListener() {
+            @Override public void onChildViewAttachedToWindow(@androidx.annotation.NonNull View child) {
+                View card = child.findViewById(R.id.card);
+                if (card == null || card.getForeground() instanceof UytvFrame) return;
+                card.setForeground(new UytvFrame(theme.frame, made[0]++, activity.getResources().getDisplayMetrics().density));
+            }
+            @Override public void onChildViewDetachedFromWindow(@androidx.annotation.NonNull View child) { }
+        });
+        for (int i = 0; i < grid.getChildCount(); i++) {
+            View card = grid.getChildAt(i).findViewById(R.id.card);
+            if (card != null && !(card.getForeground() instanceof UytvFrame))
+                card.setForeground(new UytvFrame(theme.frame, made[0]++, activity.getResources().getDisplayMetrics().density));
+        }
+    }
+
+    /** 3.0-uytv8 (Deep sea): the date again in Arabic, with Western digits, under the date. */
+    private void addArabicDate() {
+        View date = activity.findViewById(R.id.date);
+        if (date == null || !(date.getParent() instanceof ViewGroup)) return;
+        try {
+            android.icu.text.SimpleDateFormat f = new android.icu.text.SimpleDateFormat("EEEE، d MMMM",
+                    new android.icu.util.ULocale("ar@numbers=latn"));
+            TextView a = text(f.format(new java.util.Date()), 20, theme.subInk);
+            a.setAllCaps(false);
+            ViewGroup parent = (ViewGroup) date.getParent();
+            parent.addView(a, parent.indexOfChild(date) + 1);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "no Arabic date: " + e);
+        }
     }
 
     private void style(int id, Typeface face, int color, boolean caps) {
