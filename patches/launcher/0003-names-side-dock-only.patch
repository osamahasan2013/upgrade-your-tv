+        connector.setY(top);
+        connectorDot.setX(x - dp(4.5f));
+        connectorDot.setY(top - dp(4.5f));
+        connector.setVisibility(View.VISIBLE);
+        connectorDot.setVisibility(View.VISIBLE);
+    }
