--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/UytvKeep.java
@@ -0,0 +1,82 @@
+package com.gathin.tvhome;
+
+import android.Manifest;
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.PackageManager;
+import android.os.SystemClock;
+import android.provider.Settings;
+import android.util.Log;
+
+/**
+ * Upgrade Your TV (3.0-uytv15): the Home button helper kept on, in one place.
+ *
+ * A TCL force-stops a third-party home screen when it starts, which takes its accessibility service off the
+ * list: Home, the remote's buttons and "Open when the TV starts" all stopped after every power-off. While the
+ * look names the TV's own home screen (stock_home_redirect: the helper is wanted), this puts HomeKeyService back
+ * (ServiceRepair, with the WRITE_SECURE_SETTINGS the phone app grants). It runs from every way this process can
+ * start again: GuardRevival (a notification listener the system binds again after a force stop; no notification
+ * is read), the boot broadcast, Home opening, and the screen coming on while the process is alive.
+ */
+final class UytvKeep {
+    private static final String TAG = "TvHome.Keep";
+    private static volatile long restoredAt;
+    private static BroadcastReceiver screenOn;
+
+    private UytvKeep() {
+    }
+
+    /** True for a minute after the helper was put back: its next bind is the TV coming on (HomeKeyService). */
+    static boolean justRestored() {
+        long at = restoredAt;
+        return at != 0 && SystemClock.elapsedRealtime() - at < 60_000L;
+    }
+
+    static void run(Context context) {
+        try {
+            Context app = context.getApplicationContext();
+            watchScreenOn(app);
+            if (app.checkSelfPermission(Manifest.permission.WRITE_SECURE_SETTINGS) != PackageManager.PERMISSION_GRANTED) return;
+            Config cfg = Config.load(app);
+            if (cfg.stockHomeRedirect.isEmpty()) return;
+            String list = Settings.Secure.getString(app.getContentResolver(), Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES);
+            ComponentName mine = new ComponentName(app, HomeKeyService.class);
+            boolean listed = false;
+            if (list != null) {
+                for (String entry : list.split(":")) {
+                    if (mine.equals(ComponentName.unflattenFromString(entry))) listed = true;
+                }
+            }
+            boolean on = Settings.Secure.getInt(app.getContentResolver(), Settings.Secure.ACCESSIBILITY_ENABLED, 0) == 1;
+            if (listed && on) return;
+            restoredAt = SystemClock.elapsedRealtime();
+            if (listed) {
+                Settings.Secure.putInt(app.getContentResolver(), Settings.Secure.ACCESSIBILITY_ENABLED, 1);
+            } else {
+                ServiceRepair.connected(app, HomeKeyService.class);
+                ServiceRepair.restore(app);
+            }
+            Log.i(TAG, "Home button helper put back");
+        } catch (RuntimeException e) {
+            Log.w(TAG, "nothing put back: " + e);
+        }
+    }
+
+    private static synchronized void watchScreenOn(Context app) {
+        if (screenOn != null) return;
+        screenOn = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                run(app);
+            }
+        };
+        try {
+            app.registerReceiver(screenOn, new IntentFilter(Intent.ACTION_SCREEN_ON));
+        } catch (RuntimeException e) {
+            screenOn = null;
+        }
+    }
+}
