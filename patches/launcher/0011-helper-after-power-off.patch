diff --git a/launcher/app/src/main/java/com/gathin/tvhome/UytvBoot.java b/launcher/app/src/main/java/com/gathin/tvhome/UytvBoot.java
new file mode 100644
index 00000000..c76cd562
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/UytvBoot.java
@@ -0,0 +1,31 @@
+package com.gathin.tvhome;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.util.Log;
+
+/**
+ * Upgrade Your TV (3.0-uytv11): after the TV was switched off and on. Some TVs (TCL) empty the accessibility list
+ * at power-off, which took the Home button helper with it: Home, the remote's buttons and "Open when the TV
+ * starts" all stopped until Setup ran again. When the helper is set up (stock_home_redirect) this puts it back
+ * on the list (ServiceRepair, with the WRITE_SECURE_SETTINGS the phone app grants over ADB), and with
+ * power_on_home_always it opens the home screen (allowed from here by the "display over other apps" app-op the
+ * phone app sets; without it Android refuses and nothing happens).
+ */
+public final class UytvBoot extends BroadcastReceiver {
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        try {
+            Config cfg = Config.load(context);
+            if (cfg.stockHomeRedirect.isEmpty()) return;
+            ServiceRepair.connected(context, HomeKeyService.class);
+            ServiceRepair.restore(context);
+            if (cfg.powerOnHomeAlways) {
+                context.startActivity(new Intent(context, MainActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+            }
+        } catch (RuntimeException e) {
+            Log.w("TvHome.Boot", "nothing put back: " + e);
+        }
+    }
+}
